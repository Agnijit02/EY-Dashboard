generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects      Project[]      @relation("ProjectOwner")
  risks         Risk[]         @relation("RiskOwner")
  refreshTokens RefreshToken[]
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id                 String       @id @default(cuid())
  name               String
  industry           String?
  status             ClientStatus @default(ACTIVE)
  totalContractValue Float        @default(0)
  projectCount       Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  projects Project[]

  @@index([status])
  @@index([createdAt])
}

enum ClientStatus {
  ACTIVE
  AT_RISK
  INACTIVE
}

model Project {
  id          String        @id @default(cuid())
  name        String
  code        String        @unique
  description String?
  status      ProjectStatus @default(PLANNING)
  progress    Int           @default(0)
  budget      Float         @default(0)
  spent       Float         @default(0)
  startDate   DateTime?
  endDate     DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id])

  risks Risk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Resource {
  id           String             @id @default(cuid())
  name         String
  email        String             @unique
  department   ResourceDepartment
  designation  String?
  allocation   Int                @default(0)
  availability Int                @default(100)
  status       ResourceStatus     @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([department])
  @@index([status])
}

enum ResourceDepartment {
  ENGINEERING
  CONSULTING
  ANALYTICS
  STRATEGY
  OPERATIONS
}

enum ResourceStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model Risk {
  id             String       @id @default(cuid())
  riskId         String       @unique
  title          String
  description    String
  category       RiskCategory
  probability    Int
  impact         Int
  score          Int
  severity       RiskSeverity
  status         RiskStatus   @default(OPEN)
  mitigationPlan String
  dueDate        DateTime

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("RiskOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([severity])
  @@index([status])
  @@index([dueDate])
}

enum RiskCategory {
  TECHNICAL
  FINANCIAL
  OPERATIONAL
  SECURITY
  RESOURCE
  COMPLIANCE
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MONITORING
  MITIGATED
  CLOSED
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}
